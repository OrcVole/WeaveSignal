  "design_text": "The kettle is on and the morning is bright. Here is what is happening across the city today, from the harbour all the way up to the hills.",
  "intro": [
    {
      "id": "i-eilidh",
      "who": "eilidh",
      "text": "I'm Eilidh. I present The Morning Kettle, and I run the whole desk from the keyboard."
    },
    {
      "id": "i-gregor",
      "who": "gregor",
      "text": "I'm Gregor, a local historian. I'm today's guest, and I joined from a link."
    },
    {
      "id": "i-shona",
      "who": "shona",
      "text": "I'm Shona. I answer the phones and decide who gets on air."
    },
    {
      "id": "i-niall",
      "who": "niall",
      "text": "I'm Niall. I'm ringing in from my phone, straight from the station's page."
    },
    {
      "id": "i-jessie",
      "who": "jessie",
      "text": "I'm Jessie. I'm ringing in too, and I'm about to say something I shouldn't."
    },
    {
      "id": "i-finlay",
      "who": "finlay",
      "text": "I'm Finlay. I'm on after Eilidh, standing by from home."
    }
  ],
