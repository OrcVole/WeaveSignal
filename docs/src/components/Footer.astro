---
// SPDX-License-Identifier: AGPL-3.0-only
// SPDX-FileCopyrightText: 2026 The WeaveSignal contributors
// Starlight's footer with the documentation's licence line under it (ADR-0081).
import Default from '@astrojs/starlight/components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Default><slot /></Default>
<p class="licence">
  Text and images <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC BY-SA 4.0</a>;
  code samples AGPL-3.0-only, as the code is. <a href={`${base}/docs/reference/licence/`}>Licences</a>.
</p>

<style>
  .licence {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
