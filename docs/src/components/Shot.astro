// SPDX-FileCopyrightText: 2026 The WeaveSignal contributors
// A screenshot of the product in a frame, with alt text that says what it shows and an optional
// caption. `size` is "wide" for a window and "phone" for a page shot at phone width; the widths
// are what astro:assets renders, so a phone is not handed the full-size file.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  size?: 'wide' | 'phone';
}
const { src, alt, caption, size = 'wide' } = Astro.props;
const widths = size === 'phone' ? [320, 640] : [390, 780, 1152, 1440];
const sizes = size === 'phone' ? '(min-width: 50rem) 20rem, calc(100vw - 2rem)' : '(min-width: 72rem) 40rem, (min-width: 50rem) 55vw, calc(100vw - 2rem)';
---

<figure class="ws-shot" data-size={size}>
  <Image src={src} widths={widths.filter((w) => w <= src.width)} {sizes} {alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
