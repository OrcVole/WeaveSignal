---
// SPDX-License-Identifier: AGPL-3.0-only
// SPDX-FileCopyrightText: 2026 The WeaveSignal contributors
// A screenshot of the product in a frame, with alt text that says what it shows and a caption.
// `size` is "wide" for a window and "phone" for a page at phone width. Every screenshot shows
// Kettle FM, the sample station, so the caption says so once.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  size?: 'wide' | 'phone';
  eager?: boolean;
}
const { src, alt, caption, size = 'wide', eager = false } = Astro.props;
const widths = size === 'phone' ? [320, 640] : [390, 780, 1152, 1440];
const sizes = size === 'phone' ? '(min-width: 48rem) 19rem, calc(100vw - 2rem)' : '(min-width: 72rem) 56rem, calc(100vw - 2rem)';
---

<figure class="frame" data-size={size}>
  <Image src={src} widths={widths.filter((w) => w <= src.width)} {sizes} {alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
