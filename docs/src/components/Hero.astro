---
// SPDX-License-Identifier: AGPL-3.0-only
// SPDX-FileCopyrightText: 2026 The WeaveSignal contributors
// The landing page's hero in place of Starlight's: the title, the tagline and the actions from the
// page's frontmatter, then desk B at full width, since the product is the picture. Starlight's own
// hero keeps a square beside the copy, too small for a screenshot of the desk.
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
// Starlight's page-title id (its constants module is not exported): the skip link's target.
const PAGE_TITLE_ID = '_top';
import desk from '../assets/screens/reference-desk-window.png';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="ws-hero not-content">
  <div class="ws-hero-copy">
    <p class="ws-kicker">Free software for radio and video stations</p>
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {tagline && <p class="ws-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="ws-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  <figure class="ws-shot ws-hero-shot">
    <Image
      src={desk}
      widths={[390, 780, 1152, 1440]}
      sizes="(min-width: 72rem) 68rem, calc(100vw - 2rem)"
      loading="eager"
      fetchpriority="high"
      alt="The studio app's Desk tab, dark theme. The master lamp says ON AIR for The Morning Kettle on Kettle FM; Eilidh Fraser-MacLeod, Gregor Stewart and Kirsty Wilson are on air with meters and On, Cue, Talk and Mute keys; Finlay Grant and playout stand by below; the clock, the rundown, the carts and the listener count sit around the stage."
    />
    <figcaption>Desk B in the studio app: three people on air, two standing by, the profanity delay building, and a cart wall to hand.</figcaption>
  </figure>
</div>

<style>
  .ws-hero {
    display: grid;
    gap: 2rem;
    padding-block: 1rem 0.5rem;
  }
  .ws-hero-copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 64ch;
  }
  .ws-hero-copy h1 {
    font-size: clamp(var(--sl-text-3xl), calc(0.5rem + 4vw), var(--sl-text-5xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .ws-tagline {
    font-size: clamp(var(--sl-text-base), calc(0.5rem + 1.2vw), var(--sl-text-lg));
    color: var(--sl-color-gray-2);
    line-height: 1.55;
    max-width: 60ch;
  }
  .ws-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }
  .ws-hero-shot {
    width: 100%;
  }
  @media (min-width: 50rem) {
    .ws-hero {
      gap: 2.5rem;
      padding-block: 2.5rem 1rem;
    }
  }
</style>
