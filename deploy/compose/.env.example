# Copy to .env and fill in. .env holds secrets and is ignored by git.
# `weavesignal-control sample-config` makes a station identifier.
STATION_ID=00000000-0000-0000-0000-000000000000
STATION_NAME=Kettle FM
ROOM=studio
# How a caller asks for their call to be taken down: an email address or a link. Call-in stays
# closed until it is set (ADR-0124).
CONSENT_CONTACT=
# The image the desk and the control plane run (`just server-image` builds it).
SERVER_IMAGE=forgejo.weavesignal.top/weavesignal/weavesignal-server:1.0.2

LIVEKIT_API_KEY=weavesignal
# At least 32 characters.
LIVEKIT_API_SECRET=
LISTENERS_SOURCE_PASSWORD=
POSTGRES_PASSWORD=
# Leave empty to keep the admin routes off.
CONTROL_ADMIN_TOKEN=

# Keys the hash of chatters' email addresses (ADR-0125); at least 32 characters, e.g.
# `openssl rand -hex 32`. The chat will not start without it. Keep it with the database's backups:
# a different key finds none of the existing chat accounts.
CHAT_EMAIL_KEY=

# Keys the hash of staff email addresses and sign-in codes (ADR-0127), the same way; needed when
# MAIL_MODE is on.
CONTROL_EMAIL_KEY=

# Keys API tokens and webhook secrets (ADR-0195, ADR-0202): at least 32 characters, `openssl rand
# -hex 32`; weavesignal.sh makes one. Keep it with the backups: a different key revokes every token.
# Unset, the control plane derives one from CONTROL_ADMIN_TOKEN, and rotating that revokes them.
CONTROL_TOKEN_KEY=

# The chat's and the staff's sign-in codes: "off" until the station can send email ("command" pipes each to
# /usr/sbin/sendmail -t -i in the image's PATH; see weavesignal-chat sample-config).
MAIL_MODE=off
MAIL_FROM=chat@station.example
# When listeners may post in the chat (ADR-0234): "always", or "shows": while a scheduled
# episode is on air by the schedule (a show put on air by hand does not open it), and the
# station's staff at any time. Between shows the chat is read-only, signing in stays open, and
# the player says when the next show starts.
CHAT_HOURS=always

# Chat avatars (ADR-0235). true: a signed-in chatter may upload a picture of their own, which nobody
# else sees until staff approve it on the Screener tab; false: the shipped avatars only. Uploaded
# pictures are kept in the chat-avatars volume: back it up with the database. This is the default
# only until an admin uses the switch in the studio's Settings > Chat pictures (ADR-0259); after
# that the switch decides, and this setting is ignored.
AVATAR_UPLOADS=true

# Pictures and documents in the chat (ADR-0262). false (the default): the chat takes words only.
# true: a trusted chatter may attach a picture (PNG, JPEG or WebP, rewritten to a legible size with
# nothing but its pixels) or a document (PDF, OpenDocument text or spreadsheet, Markdown or plain
# text, passed on unchanged as a download). Every one is held until staff or a moderator approve
# it, so your staff will see every picture and document posted: add a line to your risk assessment
# before turning this on. They are kept in the chat-attachments volume: back it up with the
# database. The studio's switch in Settings > Chat pictures decides once it has been used.
CHAT_ATTACHMENTS=false

# Listing. Both are off until the station goes public. SEARCH_LISTING lets search engines list the
# public address (ADR-0133); DIRECTORY_LISTING makes the stream ask internet radio directories to
# list it (ADR-0129).
SEARCH_LISTING=false
DIRECTORY_LISTING=false

# The Opus stream's constant bit rate in kbit/s (ADR-0233): 64 to 256. 96 is what the audience
# sizing budgets; each listener costs this much bandwidth.
OPUS_BITRATE=96
# The MP3 streams (ADR-0002, ADR-0232): LAME-encoded, on the listener port under their own mounts,
# for directories and smart speakers that do not take Opus, and for listeners who choose them on
# the player page. Two rates, each off by default and each turned on by itself: COMPAT_* is the
# first (128 kbit/s, for voice), COMPAT_HIGH_* the second (320 kbit/s, for music: up to 2.5 times
# the bandwidth of 128 for each listener on it). The public route publishes both mounts.
COMPAT_STREAM=false
COMPAT_MOUNT=programme.mp3
COMPAT_BITRATE=128
COMPAT_HIGH_STREAM=false
COMPAT_HIGH_MOUNT=programme-high.mp3
COMPAT_HIGH_BITRATE=320
# The listener process's cushion of playout's feed, in seconds (ADR-0182); raise it to 1-2 on a busy host
# if listeners hear the fallback for moments while playout is on air.
FEED_BUFFER_S=0.5

# Playout's processing chain (ADR-0044): a slow gain control towards a loudness target, then the
# limiter. Set PROCESSING=false to take the gain control out (the limiter stays).
PROCESSING=true
PROCESSING_TARGET_LUFS=-16
PROCESSING_MAX_GAIN_DB=6

# Video (ADR-0009): cameras, the vision mixer, AV1 to HLS for the player. Off by default.
VIDEO=false

# Ports (ADR-0075): the defaults; any free port may be used instead.
CONTROL_PORT=7310
CHAT_PORT=7311
LISTENERS_PORT=7312
SRT_INGEST_PORT=7313
PLAYOUT_FEED_PORT=7315
DESK_FEED_PORT=7317
LIVEKIT_HTTP_PORT=7880
LIVEKIT_MEDIA_PORT=7882

# The public route (opt-in; see public.yaml). `weavesignal.sh --public station.example` writes
# these, derived addresses included, and runs the bundle with public.yaml; by hand, add public.yaml
# to the compose command and set what it reads. Left unset, the bundle stays on loopback.
# PUBLIC_DOMAIN=station.example
# PUBLIC_TLS=acme                  # or internal: Caddy's own CA (a private network, a test)
# ACME_EMAIL=
# PROXY_HTTPS_PORT=443             # a certificate authority reaches 443 and 80 only
# PROXY_HTTP_PORT=80
# TURN_TLS_PORT=5349               # LiveKit's TURN over TLS (ADR-0080); 15349 where 5349 is taken
# TURN_UDP_PORT=0                  # 0 is off
# LIVEKIT_TCP_PORT=0               # ICE over TCP; 0 is off
# NODE_IP=                         # LiveKit's public address; empty, found by STUN
# TURN_ALLOW_CIDRS=                # for a private NODE_IP: 10.0.0.5/32

# --- icecast-out (ADR-0226): send the programme to another Icecast server --------------------------
# For a DJ's AzuraCast (or any Icecast): the station is an Icecast source on the other server, so
# their station leaves its AutoDJ while ours is live. MP3 at ICECAST_OUT_BITRATE. Off by default.
# For AzuraCast: take the Server, Port and Mount Name from "Connection Information" on the
# station's Streamers/DJ Accounts page (the mount is likely "/"), and the user and password from a
# Streamer/DJ account there. The password is a secret: never put it anywhere but here.
# The studio's Settings choose when it sends: with the desk on air (the default), always, or never.
ICECAST_OUT=false
ICECAST_OUT_HOST=
ICECAST_OUT_PORT=8005
ICECAST_OUT_MOUNT=/
ICECAST_OUT_USER=
ICECAST_OUT_PASSWORD=
ICECAST_OUT_TLS=false
ICECAST_OUT_BITRATE=128

# --- rtmp-out (ADR-0230) -------------------------------------------------------------------------
# RTMP out: the programme's picture and sound, behind the delay, to Rumble, Odysee, PeerTube or
# any RTMP server. It needs VIDEO=true. The destinations and stream keys are added in the studio
# app (Settings, RTMP out), not here; their keys are sealed under CONTROL_TOKEN_KEY.
# VIDEO_CANVAS=                    # the picture composed: empty is 480p20; 720p30, 720p25 or 1080p30
# RTMP_RUNG=                       # the picture RTMP sends, at most the canvas; empty is the canvas
# RTMP_H264=auto                   # auto: NVENC if the desk has the GPU, else OpenH264; openh264, nvenc
# RTMP_VIDEO_KBPS=0                # H.264's bitrate; 0 is the picture's default (720p30: 2500)
