# Copy to .env and fill in. .env holds secrets and is ignored by git.
# `weavesignal-control sample-config` makes a station identifier.
STATION_ID=00000000-0000-0000-0000-000000000000
STATION_NAME=This station
ROOM=studio
# How a caller asks for their call to be taken down: an email address or a link. Call-in stays
# closed until it is set (ADR-0124).
CONSENT_CONTACT=
# The consent words a caller agrees to (issue #26); empty, the shipped words. {station}, {kept},
# {contact} and {presenter} are filled in. Write them in single quotes with each apostrophe as \',
# e.g. CONSENT_TEXT='You\'ll be live with {presenter} on {station}. To have it taken down, contact {contact}.'
# No backslash, dollar sign or per cent sign. Changing them asks every caller to agree again.
CONSENT_TEXT=
# The image the desk and the control plane run (`just server-image` builds it).
SERVER_IMAGE=forgejo.weavesignal.top/weavesignal/weavesignal-server:1.3.1

LIVEKIT_API_KEY=weavesignal
# At least 32 characters.
LIVEKIT_API_SECRET=
LISTENERS_SOURCE_PASSWORD=
POSTGRES_PASSWORD=
# Leave empty to keep the admin routes off.
CONTROL_ADMIN_TOKEN=

# Keys the hash of chatters' email addresses (ADR-0125); at least 32 characters, e.g.
# `openssl rand -hex 32`. The chat will not start without it. Keep it with the database's backups:
# a different key finds none of the existing chat accounts.
CHAT_EMAIL_KEY=

# Keys the hash of staff email addresses and sign-in codes (ADR-0127), the same way; needed when
# MAIL_MODE is on.
CONTROL_EMAIL_KEY=

# Keys API tokens and webhook secrets (ADR-0195, ADR-0202): at least 32 characters, `openssl rand
# -hex 32`; weavesignal.sh makes one. Keep it with the backups: a different key revokes every token.
# Unset, the control plane derives one from CONTROL_ADMIN_TOKEN, and rotating that revokes them.
CONTROL_TOKEN_KEY=

# Hosts in their own studios (ADR-0280): the ingest's bearer for the control plane, and
# the password it sends the desk with each source; each at least 32 characters (`openssl rand -hex
# 32`; weavesignal.sh makes both). Empty, the ingest does not start and the desk takes no sources.
INGEST_TOKEN=
DESK_SOURCES_PASSWORD=

# The chat's and the staff's sign-in codes: "off" until the station can send email ("command" pipes each to
# /usr/sbin/sendmail -t -i in the image's PATH; see weavesignal-chat sample-config).
MAIL_MODE=off
MAIL_FROM=chat@station.example
# When listeners may post in the chat (ADR-0234): "always", or "shows": while a scheduled
# episode is on air by the schedule (a show put on air by hand does not open it), and the
# station's staff at any time. Between shows the chat is read-only, signing in stays open, and
# the player says when the next show starts.
CHAT_HOURS=always

# Chat avatars (ADR-0235). true: a signed-in chatter may upload a picture of their own, which nobody
# else sees until staff approve it on the Screener tab; false: the shipped avatars only. Uploaded
# pictures are kept in the chat-avatars volume: back it up with the database. This is the default
# only until an admin uses the switch in the studio's Settings > Chat pictures (ADR-0259); after
# that the switch decides, and this setting is ignored.
AVATAR_UPLOADS=true

# Pictures and documents in the chat (ADR-0262). false (the default): the chat takes words only.
# true: a trusted chatter may attach a picture (PNG, JPEG or WebP, rewritten to a legible size with
# nothing but its pixels) or a document (PDF, OpenDocument text or spreadsheet, Markdown or plain
# text, passed on unchanged as a download). Every one is held until staff or a moderator approve
# it, so your staff will see every picture and document posted: add a line to your risk assessment
# before turning this on. They are kept in the chat-attachments volume: back it up with the
# database. The studio's switch in Settings > Chat pictures decides once it has been used.
CHAT_ATTACHMENTS=false

# Listing. Both are off until the station goes public. SEARCH_LISTING lets search engines list the
# public address (ADR-0133); DIRECTORY_LISTING makes the stream ask internet radio directories to
# list it (ADR-0129).
SEARCH_LISTING=false
DIRECTORY_LISTING=false

# The Opus stream's constant bit rate in kbit/s (ADR-0233): 64 to 256. 96 is what the audience
# sizing budgets; each listener costs this much bandwidth.
OPUS_BITRATE=96
# The MP3 streams (ADR-0002, ADR-0232): LAME-encoded, on the listener port under their own mounts,
# for directories and smart speakers that do not take Opus, and for listeners who choose them on
# the player page. Two rates, each off by default and each turned on by itself: COMPAT_* is the
# first (128 kbit/s, for voice), COMPAT_HIGH_* the second (320 kbit/s, for music: up to 2.5 times
# the bandwidth of 128 for each listener on it). The public route publishes both mounts.
COMPAT_STREAM=false
COMPAT_MOUNT=programme.mp3
COMPAT_BITRATE=128
COMPAT_HIGH_STREAM=false
COMPAT_HIGH_MOUNT=programme-high.mp3
COMPAT_HIGH_BITRATE=320
# The listener process's cushion of playout's feed, in seconds (ADR-0182); raise it to 1-2 on a busy host
# if listeners hear the fallback for moments while playout is on air.
FEED_BUFFER_S=0.5

# Playout's processing chain (ADR-0044): a slow gain control towards a loudness target, then the
# limiter. Set PROCESSING=false to take the gain control out (the limiter stays).
PROCESSING=true
PROCESSING_TARGET_LUFS=-16
PROCESSING_MAX_GAIN_DB=6

# The show the desk heads, what is coming up and the callers banned before (issue 5). Leave them
# empty for the control plane's own defaults: no show set, no rundown, no bans, listeners 15.5 s
# behind not counting the profanity delay (ADR-0103), made of the listener mount's own fixed 12 s
# hold, a player's 3 s (STUDIO_PLAYER_ALLOWANCE_MS; 0.5 s before 1.3.1) and the listener process's buffer, which the
# desk reads (ADR-0289). STUDIO_LISTENER_DELAY_MS is the older way to say the first two as one
# figure (13000, with the buffer's 0.5 s inside it): a station that has it keeps its figure, and
# it is ignored while STUDIO_PLAYER_ALLOWANCE_MS is set. STUDIO_SHOW is plain text with no quote or
# backslash. The two lists are TOML inline tables, comma-separated, in single quotes so that the
# quotes inside them stay as written:
# STUDIO_SHOW=The Morning Kettle
# STUDIO_PLAYER_ALLOWANCE_MS=3000
# STUDIO_LISTENER_DELAY_MS=13000
# STUDIO_RUNDOWN='{ at = "10:00", title = "News", detail = "hard post", hard_post = true, key = "F2" }, { at = "10:06", title = "Weather" }'
# STUDIO_BANNED='{ identity = "tavish", date = "2026-09-12", reason = "Abuse on air" }'
STUDIO_SHOW=
STUDIO_PLAYER_ALLOWANCE_MS=
STUDIO_LISTENER_DELAY_MS=
STUDIO_RUNDOWN=
STUDIO_BANNED=

# HLS content steering among the station's edges (ADR-0051); off while STEERING_EDGES is empty.
# The edges are TOML inline tables as above (pathway, host, weight, check_url):
# STEERING_EDGES='{ pathway = "edge-1", host = "edge-1.edges.example", check_url = "http://edge-1.edges.example/health" }, { pathway = "bunny", weight = 0 }'
STEERING_TTL_S=300
STEERING_CHECK_EVERY_S=5
STEERING_CHECK_TIMEOUT_MS=2000
STEERING_DOWN_AFTER=2
STEERING_CLONE_FROM=.
STEERING_EDGES=

# Video (ADR-0009): cameras, the vision mixer, AV1 to HLS for the player. Off by default.
VIDEO=false
# Video's encoder: auto (NVENC's AV1 when the desk has an NVIDIA card, else SVT-AV1 on the CPU),
# nvenc or svt. A rung NVENC cannot take is encoded by SVT-AV1, and the desk says so.
VIDEO_ENCODER=auto
# A GPU for the desk (17e): none (the CPU), nvidia (the card named by GPU_DEVICE, handed over by
# its CDI name through gpu.yaml, with VIDEO=true), or auto: weavesignal.sh looks for an NVIDIA CDI
# spec (`nvidia-ctk cdi generate` writes one to /etc/cdi) and writes nvidia or none here.
# With no GPU line, a new install looks (auto); a station installed before keeps GPU=none, because
# an update never moves video to a card by itself (1.3.0). The studio app's Settings says when a
# card is there and not used (GPU_FOUND, which weavesignal.sh writes on every run: not a setting).
GPU=none
# GPU_DEVICE=nvidia.com/gpu=all     # one card of several: nvidia.com/gpu=0
# NVENC_SESSIONS=12                 # NVENC sessions the desk may open, 0 to 64

# Ports (ADR-0075): the defaults; any free port may be used instead.
CONTROL_PORT=7310
CHAT_PORT=7311
LISTENERS_PORT=7312
SRT_INGEST_PORT=7313
PLAYOUT_FEED_PORT=7315
DESK_FEED_PORT=7317
DESK_SOURCES_PORT=7318
INGEST_WHIP_PORT=7319
LIVEKIT_HTTP_PORT=7880
LIVEKIT_MEDIA_PORT=7882

# The public route (opt-in; see public.yaml). `weavesignal.sh --public station.example` writes
# these, derived addresses included, and runs the bundle with public.yaml; by hand, add public.yaml
# to the compose command and set what it reads. Left unset, the bundle stays on loopback.
# PUBLIC_DOMAIN=station.example
# PUBLIC_TLS=acme                  # or internal: Caddy's own CA (a private network, a test)
# ACME_EMAIL=
# PROXY_HTTPS_PORT=443             # a certificate authority reaches 443 and 80 only
# PROXY_HTTP_PORT=80
# TURN_TLS_PORT=5349               # LiveKit's TURN over TLS (ADR-0080); 15349 where 5349 is taken
# TURN_UDP_PORT=0                  # 0 is off
# LIVEKIT_TCP_PORT=0               # ICE over TCP; 0 is off
# NODE_IP=                         # LiveKit's public IPv4 address; empty, weavesignal.sh uses the A record
#                                  # of PUBLIC_DOMAIN (no STUN server is asked, ADR-0290). By hand, set
#                                  # LIVEKIT_NODE_IP to the address and LIVEKIT_USE_EXTERNAL_IP=false.
# TURN_ALLOW_CIDRS=                # for a private NODE_IP: 10.0.0.5/32
# INGEST_BIND=0.0.0.0              # where the ingest listens for hosts (weavesignal.sh --public sets it)
# PUBLIC_ORIGIN=                   # the address cards and feeds print; --public sets it. On a station
#                                  # without --public, set it by hand (http://192.168.1.20:7310 on a
#                                  # private network) and weavesignal.sh keeps it

# The listen-only route for a home network (opt-in; see lan.yaml). `weavesignal.sh --lan` (or
# `--lan 192.168.1.20`) writes these and runs the bundle with lan.yaml: one small web server on
# this machine's one address, plain HTTP, passing the player and the stream only (the studio, its
# sign-in, call-in, the chat and the live room stay on loopback). By hand, add lan.yaml to the
# compose command, set both, and set STREAM_URL to http://<LAN_ADDRESS>:<LAN_PORT>/programme.opus.
# It does not set PUBLIC_ORIGIN, which also turns on cards, feeds and invitation links.
# LAN_ADDRESS=192.168.1.20         # an address of this machine (private; never a public one)
# LAN_PORT=7300                    # TCP; 17300 or 27300 where 7300 is taken
# STREAM_URL=                      # the player's audio source (--lan derives it from the two above)

# STUN servers the station may ask (ADR-0290): host:port each, comma-separated, at most four.
# LiveKit, the desk and the join pages all read it. Empty: no STUN server is contacted, which
# is right for a station with a public address; the packages reference (STUN servers) lists some that answered.
# STUN_SERVERS=

# How the desk's senders (each return, the programme picture) control congestion: gcc (the
# default; GStreamer's free implementation of Google's published algorithm), homegrown (its own
# simple heuristic) or disabled. It sees only the desk-to-room hop, on this machine.
# CONGESTION_CONTROL=gcc

# Hosts in their own studios (ADR-0280): the public ports for hosts' own software.
# Off (0) unless set; once set, the ingest listens on them only while a show key exists, and the
# station's rules show them and cannot change them. Open them in the firewall when you set them.
# SOURCE_ICECAST_PORT=8005         # TCP, Icecast sources; or 18005, 28005
# SOURCE_SRT_PORT=9710             # UDP, SRT sources; or 19710, 29710
# SOURCE_WHIP_PORT=9712            # UDP, WHIP's sound from OBS (17d); or 19712, 29712. The offer comes
#                                  # over HTTPS to PUBLIC_DOMAIN's /whip/, so it needs --public; the
#                                  # one ICE candidate is LiveKit's address (NODE_IP)
# The bridge (Phase 17g): the studio app carries a host's own software over one WebSocket on the
# public route's 443 (/api/v1/sources/bridge), so no source port need be open. The ingest takes it
# on this loopback port; 0 turns the bridge off.
# SOURCE_BRIDGE_PORT=7320          # TCP, loopback; or 17320, 27320

# The presenter kit (Phase 17g): VBAN in from a studio PC on this station's own network, bound to
# show keys in the studio, and VBAN out from the desk. VBAN has no password and no encryption:
# keep it to one local network (or carry it through WireGuard). Off unless true; weavesignal.sh
# writes it into the settings file and keeps what is set there.
# KIT_VBAN=false

# Pulled sources (1.2): a show can come from a stream the station opens itself. By default a pull
# may not open loopback, private, link-local or carrier-grade NAT addresses, nor names such as
# localhost; true allows them, for an encoder on the station's own network or a test station.
# PULL_ALLOW_PRIVATE=false

# --- icecast-out (ADR-0226): send the programme to another Icecast server --------------------------
# For a DJ's AzuraCast (or any Icecast): the station is an Icecast source on the other server, so
# their station leaves its AutoDJ while ours is live. MP3 at ICECAST_OUT_BITRATE. Off by default.
# For AzuraCast: take the Server, Port and Mount Name from "Connection Information" on the
# station's Streamers/DJ Accounts page (the mount is likely "/"), and the user and password from a
# Streamer/DJ account there. The password is a secret: never put it anywhere but here.
# The studio's Settings choose when it sends: with the desk on air (the default), always, or never.
ICECAST_OUT=false
ICECAST_OUT_HOST=
ICECAST_OUT_PORT=8005
ICECAST_OUT_MOUNT=/
ICECAST_OUT_USER=
ICECAST_OUT_PASSWORD=
ICECAST_OUT_TLS=false
ICECAST_OUT_BITRATE=128

# --- rtmp-out (ADR-0230) -------------------------------------------------------------------------
# RTMP out: the programme's picture and sound, behind the delay, to Rumble, Odysee, PeerTube or
# any RTMP server. It needs VIDEO=true. The destinations and stream keys are added in the studio
# app (Settings, RTMP out), not here; their keys are sealed under CONTROL_TOKEN_KEY.
# VIDEO_CANVAS=                    # the picture composed: empty is 480p20; 720p30, 720p25 or 1080p30
# RTMP_RUNG=                       # the picture RTMP sends, at most the canvas; empty is the canvas
# RTMP_H264=auto                   # auto: NVENC if the desk has the GPU, else OpenH264; openh264, nvenc
# RTMP_VIDEO_KBPS=0                # H.264's bitrate; 0 is the picture's default (720p30: 2500)

# --- The rehearsal studio (1.3) ----------------------------------------------------------------------
# A second desk, with no way to the air, where a show's people rehearse before they move to the live
# studio on the same links. true runs rehearsal.yaml and turns it on in the control plane; it needs no
# port of its own, and costs memory and CPU of its own while people rehearse.
REHEARSAL=false

# --- The telephone line (17f; being built for 1.2) ---------------------------------------------------
# Off until a trunk is set. Run with phone.yaml (Valkey and LiveKit's SIP service). The numbers and
# addresses are TOML strings, comma-separated: PHONE_NUMBERS="+441314960000"
# PHONE_ALLOWED_ADDRESSES="203.0.113.0/24", "198.51.100.9". The trunk's digest password, when the
# provider uses one, is PHONE_TRUNK_PASSWORD: a secret, kept here only.
PHONE=false
# PHONE_NUMBERS=
# PHONE_ALLOWED_ADDRESSES=
# PHONE_AUTH_USERNAME=
# PHONE_TRUNK_PASSWORD=
# PHONE_PUBLIC_IP=                 # the station's public IP address (no STUN, ADR-0290)
# PHONE_COUNTRY_CODE=              # 44: how a typed number's forms are made for a ban or a takedown
# PHONE_LINES=8                    # calls at once; the RTP range is two ports per line
# PHONE_SIP_PORT=5060              # UDP and TCP, open to the provider's addresses only
# PHONE_SIP_LISTEN=                # one of this machine's IPv4 addresses for SIP to listen on (the one
#                                  # the provider reaches); empty, every address
# PHONE_RTP_PORT=7340              # even; 7340-7355 for 8 lines, UDP, open to the provider
# PHONE_RTP_LAST=7355              # PHONE_RTP_PORT + 2 x PHONE_LINES - 1 (LiveKit's SIP service takes the range)
# PHONE_CONSENT_WORDS=true         # the words before the queue; see "Take phone calls" for when they may be off
# PHONE_DEFAULT_VOICE=alba         # the shipped recording until you record your own: alba (a Scottish woman),
#                                  # edinburgh (a man from Edinburgh) or own (none: yours only)
# PHONE_REDIS_PORT=7321            # Valkey, loopback only (7319 is INGEST_WHIP_PORT, 7320 SOURCE_BRIDGE_PORT)
# PHONE_REDIS_PASSWORD=            # a secret: weavesignal.sh makes one
