{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeaveSignal",
  "version": "1.0.0",
  "identifier": "org.weavesignal.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:17420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "WeaveSignal",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "WeaveSignal's studio app",
    "longDescription": "The studio for a WeaveSignal station: the desk, the screener and the cart wall in one window.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "copyright": "2026 The WeaveSignal contributors",
    "linux": {
      "deb": {
        "desktopTemplate": "../../../deploy/desktop/weavesignal-studio.desktop",
        "section": "sound"
      },
      "rpm": {
        "desktopTemplate": "../../../deploy/desktop/weavesignal-studio.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  }
}
